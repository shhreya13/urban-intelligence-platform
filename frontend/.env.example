# Base URL of the FastAPI backend (see backend/app/main.py)
VITE_API_URL=http://localhost:8000

# true  -> always use src/data/mockEvents.js (no backend needed)
# false -> call the live backend; if unreachable, falls back to mock data
#          automatically and shows "Backend unavailable — using demo data"
VITE_USE_MOCK=false
